# Copy this file to .env and fill in your key. .env is git-ignored.

# Required: Anthropic API key - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: model used for evaluations. Default: claude-opus-5
# Any model with adaptive thinking + structured outputs works, e.g. claude-sonnet-5
# ANTHROPIC_MODEL=claude-sonnet-5
